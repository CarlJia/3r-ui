# 3R-UI environment configuration.
# Edit and reload: systemctl daemon-reload && systemctl restart 3r-ui

# Where 3r-ui keeps its SQLite DB, xray-core binary, and runtime state.
DATA_DIR=/var/lib/3r-ui

# Where the panel writes logs (xray stderr is mirrored here too).
# /var/log/3r-ui/xray.log is created on first start.
LOG_DIR=/var/log/3r-ui

# Loopback only by default — terminate TLS with Caddy / Nginx in production.
BIND_ADDR=127.0.0.1:2053

# Public hostname embedded in VLESS share URIs. Set to the hostname clients
# connect to (e.g. vpn.example.com); the panel will refuse to render a share
# link when this is empty rather than silently ship a 127.0.0.1 URL.
PUBLIC_HOST=

# Base URL of the GitHub release for xray-core auto-download. Override to a
# mirror if your server cannot reach it directly.
XRAY_DOWNLOAD_BASE=https://github.com

# Stats poll interval in seconds (R7 / U7). 30s is the plan default.
STATS_INTERVAL_SECS=30

# tracing-subscriber EnvFilter directive. info by default; debug for noise.
RUST_LOG=info,three_r_ui=info